# Valores exclusivos de desenvolvimento. Troque todas as senhas fora do ambiente local.
APP_VERSION=2.0.0
SERVICE_NAME=techx-tasks-api
NODE_ENV=development

MYSQL_DATABASE=techx_tasks
MYSQL_USER=techx
MYSQL_PASSWORD=techx
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306

MONGO_DATABASE=techx_tasks
MONGO_ROOT_USER=techx_mongo
MONGO_ROOT_PASSWORD=techx_mongo
MONGO_PORT=27017
MONGO_TASK_METADATA_COLLECTION=task_metadata
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

API_PORT=3333
FRONTEND_PORT=4200
CORS_ORIGIN=http://localhost:4200
JSON_BODY_LIMIT=1mb
LOG_LEVEL=info
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

JWT_SECRET=desenvolvimento-local-jwt-secret-com-32-caracteres
JWT_ISSUER=techx-tasks-api
JWT_AUDIENCE=techx-tasks-web
JWT_EXPIRES_IN_SECONDS=3600
