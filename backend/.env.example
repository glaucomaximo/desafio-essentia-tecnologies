APP_VERSION=2.0.0
SERVICE_NAME=techx-tasks-api
PORT=3333
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200
JSON_BODY_LIMIT=1mb

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=techx
DB_PASSWORD=techx
DB_NAME=techx_tasks

MONGO_URI=mongodb://techx_mongo:techx_mongo@127.0.0.1:27017/techx_tasks?authSource=admin
MONGO_DB_NAME=techx_tasks
MONGO_TASK_METADATA_COLLECTION=task_metadata
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

JWT_SECRET=desenvolvimento-local-jwt-secret-com-32-caracteres
JWT_ISSUER=techx-tasks-api
JWT_AUDIENCE=techx-tasks-web
JWT_EXPIRES_IN_SECONDS=3600

LOG_LEVEL=info
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
