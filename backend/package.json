{
  "name": "backend",
  "version": "2.0.0",
  "private": true,
  "description": "API RESTful em Node.js e TypeScript para o desafio TechX Tasks.",
  "author": "Glauco Maximo <glaucomaximo@gmail.com>",
  "license": "MIT",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "helmet": "^7.1.0",
    "jose": "6.2.10",
    "mongodb": "7.6.0",
    "mysql2": "^3.9.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "~6.0.3"
  }
}
